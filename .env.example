# CodeGuru environment configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never share .env or upload it to GitHub!

# ── AI PROVIDER API KEYS ──────────────────────────────────────
# Get keys from:
#   Gemini     → https://aistudio.google.com
#   Groq       → https://console.groq.com
#   Cerebras   → https://cloud.cerebras.ai
#   Mistral    → https://console.mistral.ai
#   OpenRouter → https://openrouter.ai

GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# ── SECURITY ──────────────────────────────────────────────────
# JWT signing secret. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# ── DATABASE ──────────────────────────────────────────────────
# Optional — defaults to sqlite at project root (codeguru.db)
# DATABASE_URL=sqlite:///./codeguru.db

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated allowed origins. Use * only for local development.
# Example: CORS_ORIGINS=https://myapp.vercel.app,http://localhost:3000
CORS_ORIGINS=*

# ── APP SETTINGS ──────────────────────────────────────────────
# Set to true for mock AI responses (no API calls, no cost)
MOCK_MODE=False
