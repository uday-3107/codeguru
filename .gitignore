# ============================================================
# CodeGuru .gitignore
# Protects secrets, runtime artifacts, caches, and build output
# ============================================================

# ── Secrets — NEVER commit these ──────────────────────────────
.env
.env.*
!.env.example

# ── Python bytecode / caches ──────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ── Python packaging / builds ─────────────────────────────────
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# ── Virtual environments (any tool) ───────────────────────────
env/
venv/
.venv/
ENV/

# ── Database — runtime artifacts only ─────────────────────────
codeguru.db
*.db-journal
*.sqlite3
*.sqlite3-journal

# ── Node / frontend (React SPA lives in frontend/) ────────────
node_modules/
frontend/dist/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm

# ── Editors / IDEs ────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Operating system junk ─────────────────────────────────────
.DS_Store
._*
Icon?
Thumbs.db
desktop.ini

# ── Logs & temp files ─────────────────────────────────────────
*.log
logs/
tmp/
.tmp/
